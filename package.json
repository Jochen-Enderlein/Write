{
  "name": "write",
  "productName": "Write",
  "version": "0.2.0",
  "description": "Notion-artiger Blockeditor auf offenen Markdown-Dateien",
  "main": "./out/main/index.js",
  "type": "module",
  "private": true,
  "author": "Jochen Enderlein",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/Jochen-Enderlein/Write",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jochen-Enderlein/Write.git"
  },
  "bugs": "https://github.com/Jochen-Enderlein/Write/issues",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:perf": "vitest run -c vitest.perf.config.ts",
    "generate-vault": "node scripts/generate-vault.mjs",
    "test:e2e": "npm run build && playwright test",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run test:e2e",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run build && APPLE_KEYCHAIN_PROFILE=write-notary electron-builder --mac --publish never",
    "dist:local": "npm run build && electron-builder --mac --publish never -c.mac.identity=- -c.mac.hardenedRuntime=false -c.mac.notarize=false",
    "release": "node scripts/release.mjs prepare && npm run build && node scripts/release.mjs notes && APPLE_KEYCHAIN_PROFILE=write-notary electron-builder --mac --publish always && node scripts/release.mjs publish",
    "dist:signed": "npm run build && electron-builder --mac --publish never -c.mac.notarize=false"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "electron-liquid-glass": "1.1.1",
    "electron-updater": "6.8.9",
    "i18next": "26.4.2",
    "isomorphic-git": "1.43.0",
    "ulid": "3.0.2",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@blocknote/code-block": "0.55.0",
    "@blocknote/core": "0.55.0",
    "@blocknote/mantine": "0.55.0",
    "@blocknote/react": "0.55.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@eslint/js": "10.0.1",
    "@lezer/highlight": "1.2.5",
    "@mantine/core": "9.7.0",
    "@mantine/hooks": "9.7.0",
    "@playwright/test": "1.63.0",
    "@tiptap/core": "3.31.4",
    "@types/better-sqlite3": "9.6.0",
    "@types/jsdom": "30.0.0",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "5.2.0",
    "chokidar": "5.0.0",
    "cmdk": "1.1.1",
    "diff": "9.0.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "mdast-util-to-string": "4.0.0",
    "mermaid": "12.1.0",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-arborist": "3.16.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "shiki": "4.5.0",
    "three": "0.186.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "unified": "11.0.5",
    "vite": "7.3.6",
    "vitest": "5.0.3",
    "zustand": "5.0.15"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false
  }
}
